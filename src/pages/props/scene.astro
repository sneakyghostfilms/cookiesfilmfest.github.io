---
import PropsLayout from "../../layouts/props-layout.astro";
import propsConfig from "../../data/props/config.json";
import { cardsText, cardsVersion } from "../../scripts/props-cards-file.js";

const description = "Paste a scene and find props for it in Pittsburgh prop rental catalogs, with item numbers, catalog pages and how to inquire.";
const apiUrl: string = import.meta.env.PUBLIC_PROPS_API_URL || propsConfig.apiUrl;
// Matches are drawn from the keyword page's /props/cards.json, which this page loads with its first scene.
const cardsUrl = `/props/cards.json?v=${cardsVersion(cardsText(process.env))}`;
---

<PropsLayout title="Paste a Scene | Pittsburgh Prop Search | Cookies and Comedy Film Festival" description={description} current="scene">
  <h2 class="scene-title">Paste a scene to find props</h2>
  <form id="scene-form" class="scene-form" data-api-url={apiUrl} data-cards-url={cardsUrl}>
    <label class="props-field">
      <span>Scene text</span>
      <textarea id="scene-text" rows="8" maxlength="4000" placeholder="Paste up to 4,000 characters of a scene, e.g. INT. DINER - NIGHT. A waitress pours coffee while the detective drops his badge on the counter." disabled={!apiUrl}></textarea>
    </label>
    <div class="scene-row">
      <label class="props-field scene-period">
        <span>Time period or setting (optional)</span>
        <input id="scene-period" type="text" maxlength="40" placeholder="1960s, WWII, present day" autocomplete="off" disabled={!apiUrl} />
      </label>
      <p class="props-note scene-count"><span id="scene-count">0</span> / 4,000 characters</p>
    </div>
    <p class="props-note scene-disclosure">Your scene text and time period are sent to Cloudflare, where a language model picks props from these catalogs. This site doesn't store or log them. Matches can be wrong, so check each item with its vendor.</p>
    {!apiUrl && <p class="scene-off">Scene matching isn't switched on yet. Keyword search works.</p>}
    <button id="scene-submit" type="submit" class="props-button" disabled={!apiUrl}>Find props for this scene</button>
  </form>
  <noscript><p class="props-note">Scene matching needs JavaScript. The prop sources, with their contact details, are listed without it on <a href="/props/sources">the prop sources page</a>.</p></noscript>
  <p id="scene-status" class="scene-status" aria-live="polite" hidden></p>
  <div id="scene-results" class="scene-results"></div>

  <script>import "../../scripts/props-scene-page.ts";</script>
</PropsLayout>
