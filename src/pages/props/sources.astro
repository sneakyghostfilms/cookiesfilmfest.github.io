---
import PropsLayout from "../../layouts/props-layout.astro";
import vendorsData from "../../data/props/vendors.json";
import inventory from "../../data/props/inventory.json";
import { privateVendorsFor } from "../../../scripts/props/demo-links.mjs";
import { catalogLines, contactRoutes, privateFacts, socialLinks, vendorBadges, vendorFactGroups, vendorSources } from "../../scripts/props-cards.js";

const description = "Pittsburgh prop rental sources, with the contact details each publishes and the catalogs that are searchable.";
const privateVendors = privateVendorsFor(process.env);
const itemCounts = new Map<string, number>();
for (const item of inventory.items) itemCounts.set(item.catalog, (itemCounts.get(item.catalog) ?? 0) + 1);
const vendorsWithItems = vendorsData.vendors.filter((vendor) => inventory.items.some((item) => item.vendor === vendor.id));
const byName = (a: { name: string }, b: { name: string }) => a.name.localeCompare(b.name, "en");
const vendorsWithoutItems = vendorsData.vendors.filter((vendor) => !vendorsWithItems.includes(vendor)).sort(byName);
const indexed = inventory.catalogs as Record<string, { indexedAt: string; capturedAt?: string }>;
// A row names the place with capitals even where a vendor publishes it in lowercase; the details keep it verbatim.
const cityCaps = (city: string) => city.replace(/(^|[\s/-])([a-z])/g, (_, before, letter) => before + letter.toUpperCase());
const stateCaps = (state: string) => (/^[a-z]{2}$/i.test(state) ? state.toUpperCase() : state);
// Each vendor's row names it, its type and modes, its place and how many of its items are searchable; the row opens to
// the facts the vendor publishes.
const vendorRows = [...[...vendorsWithItems].sort(byName), ...vendorsWithoutItems].map((vendor) => {
  const badges = vendorBadges(vendor);
  const place = vendor.address ?? vendor.mailingAddress;
  const items = vendor.catalogs.reduce((sum, catalog) => sum + (itemCounts.get(catalog.id) ?? 0), 0);
  return {
    vendor,
    type: badges.filter((badge) => !badge.regional).map((badge) => badge.text).join(" · "),
    regional: badges.some((badge) => badge.regional),
    place: place ? [place.city && cityCaps(place.city), place.state && stateCaps(place.state)].filter(Boolean).join(", ") : "",
    items: items ? `${items.toLocaleString("en-US")} ${items === 1 ? "item" : "items"} searchable` : null,
    facts: vendorFactGroups(vendor),
    routes: contactRoutes(vendor.contact),
    social: socialLinks(vendor.social),
    sources: vendorSources(vendor),
    private: privateFacts(privateVendors?.[vendor.id]),
    catalogs: catalogLines(vendor, { indexed, itemCounts }),
  };
});
---

<PropsLayout title="Prop Sources | Pittsburgh Prop Search | Cookies and Comedy Film Festival" description={description} current="sources">
  {privateVendors && <p slot="markers" class="props-demo-marker"><span>Private vendor notes visible: do not screenshare</span></p>}

  <div class="props-sources-head">
    <h2 id="prop-sources" class="props-sources-title">Prop sources ({vendorRows.length})</h2>
    <p class="props-sources-lede">Vendors with searchable items first, then the rest by name. Open a row for the details each vendor publishes.</p>
  </div>
  <div class="props-directory">
    {vendorRows.map(({ vendor, type, regional, place, items, facts, routes, social, sources, private: privateLines, catalogs: vendorCatalogs }) => (
      <details class="props-vendor" id={`vendor-${vendor.id}`} data-vendor={vendor.id}>
        <summary class="props-vendor-row">
          <span class="props-vendor-name">{vendor.name}</span>{" "}
          <span class="props-vendor-type">{type}</span>{" "}
          <span class="props-vendor-place">{place}{regional && <> <span class="props-regional">Regional</span></>}</span>{" "}
          <span class:list={["props-vendor-items", { "props-vendor-searchable": items }]}>{items ?? "Not indexed"}</span>
        </summary>
        <div class="props-vendor-panel">
          <dl class="props-vendor-facts">
            <div>
              <dt>Inquiries</dt>
              <dd>
                <p class="props-vendor-routes">{routes.map((route, position) => (
                  <>{position > 0 && " · "}<a href={route.href} {...(route.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{route.label}</a></>
                ))}{social.map((link) => <> · <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></>)}</p>
                <p>{facts.terms}</p>
                {facts.hint && <p>{facts.hint}</p>}
              </dd>
            </div>
            {facts.notice && <div><dt>Notice on their site</dt><dd><p>{facts.notice}</p></dd></div>}
            {facts.words && <div><dt>In their words</dt><dd><p>{facts.words}</p></dd></div>}
            <div>
              <dt>Searchable here</dt>
              <dd>{vendorCatalogs.map((line) => (
                <p class="props-catalog">{line.text}{line.href && <a href={line.href} target="_blank" rel="noopener noreferrer">{line.linkLabel}</a>}{line.links?.map((link, position) => (
                  <>{position > 0 && " · "}<a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></>
                ))}</p>
              ))}</dd>
            </div>
            {facts.where.length > 0 && <div><dt>Where and when</dt><dd>{facts.where.map((line) => <p>{line}</p>)}</dd></div>}
          </dl>
          <p class="props-note props-vendor-sources">Details as the vendor publishes them, last checked {vendor.lastVerified}: {sources.map((source, position) => (
            <>{position > 0 && " · "}{source.href ? <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a> : source.label}</>
          ))}.</p>
          {privateLines.length > 0 && (
            <div class="props-vendor-private">
              <p class="props-note">Private, local demo only:</p>
              {privateLines.map((line) => <p class="props-note">{line}</p>)}
            </div>
          )}
        </div>
      </details>
    ))}
  </div>
</PropsLayout>
