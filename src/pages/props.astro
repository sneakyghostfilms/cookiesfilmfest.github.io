---
import "../styles/index.css";
import "@fontsource-variable/inter";
import vendorsData from "../data/props/vendors.json";
import inventory from "../data/props/inventory.json";
import tagsData from "../data/props/tags.json";
import propsConfig from "../data/props/config.json";
import { displayEra } from "../../scripts/props/normalize.mjs";
import { DEMO_STYLES, DEMO_URL, demoCatalogHref, readDemoManifest } from "../../scripts/props/demo-links.mjs";
import { compareByName } from "../scripts/props-search.js";

const { generator } = Astro;
const apiUrl: string = import.meta.env.PUBLIC_PROPS_API_URL || propsConfig.apiUrl;
const description = "Search Pittsburgh prop rental catalogs in plain English, with item numbers, catalog pages and how to inquire.";
const demo = process.env.PROPS_DEMO === "1" ? readDemoManifest() : null;

const catalogs = new Map(
  vendorsData.vendors.flatMap((vendor) => vendor.catalogs.map((catalog) => [catalog.id, { ...catalog, vendor }])),
);

function idsLabel(itemNumbers: string[]) {
  return itemNumbers.length ? itemNumbers.map((number) => `#${number}`).join(" / ") : "no item number printed";
}

function pagesLabel(pages: number[]) {
  return pages.length > 1 ? `pages ${pages.join(", ")}` : `page ${pages[0]}`;
}

const cards = inventory.items
  .map((item, order) => ({ ...item, order }))
  .sort(compareByName)
  .map((item) => {
    const catalog = catalogs.get(item.catalog)!;
    const position = demo?.items?.[item.key];
    return {
      ...item,
      vendorName: catalog.vendor.name,
      ids: idsLabel(item.itemNumbers),
      era: item.era ? displayEra(item.era) : null,
      pageText: pagesLabel(item.pages),
      catalogHref: position ? demoCatalogHref(position) : catalog.sourceUrl,
      catalogLabel: position ? "Open catalog (local PDF)" : "Open catalog on Google Drive",
      thumb: position ? { src: `${DEMO_URL}/thumbs/${item.key}.webp`, ...position.thumb } : null,
      formUrl: catalog.vendor.contact.formUrl,
      tags: (tagsData.tags as Record<string, string[]>)[item.key] ?? [],
    };
  });

const categories = [...new Set(inventory.items.flatMap((item) => item.categories))].sort();
const decades = [...new Set(inventory.items.flatMap((item) => item.decades))].sort((a, b) => a - b);
const vendorBoxes = vendorsData.vendors.map((vendor) => ({
  vendor,
  catalogs: vendor.catalogs.map((catalog) => ({
    ...catalog,
    indexedAt: (inventory.catalogs as Record<string, { indexedAt: string }>)[catalog.id]?.indexedAt,
  })),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta name="generator" content={generator} />

    <title>Pittsburgh Prop Search | Cookies and Comedy Film Festival</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Pittsburgh Prop Search" />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />

  </head>
  <body class="props-page">
    <div class="props-wrap">
      <header class="props-header">
        <h1 class="props-title">Pittsburgh Prop Search</h1>
        <p class="props-subtitle">Search local prop rental catalogs in plain English.</p>
        <a href="/" class="props-back">Back to Main Site</a>
        {demo && <p class="props-demo-marker"><span>Local demo, not public</span></p>}
      </header>

      <section class="props-box props-about">
        <p>A discovery tool for Pittsburgh filmmakers. It does not book rentals or show live availability. <strong>Always confirm availability, condition, sizes and price with the vendor.</strong> Item numbers, names, eras and page numbers are copied from each vendor's catalog. Not affiliated with {vendorsData.vendors.map((vendor) => vendor.name).join(", ")}. Keyword search runs in your browser.</p>
        {vendorsData.vendors.map((vendor) => (
          <p class="props-contact">To rent from {vendor.name}: <a href={vendor.contact.formUrl} target="_blank" rel="noopener noreferrer">official contact form</a> or <a href={`mailto:${vendor.contact.email}`}>{vendor.contact.email}</a>. Pricing is by quote.</p>
        ))}
      </section>

      <section class="props-box props-search">
        <form id="props-form" class="props-controls" role="search">
          <label class="props-field props-query">
            <span>Search props</span>
            <input id="props-query" type="search" placeholder="e.g. rotary phone, police jacket, 60s office" autocomplete="off" />
          </label>
          <label class="props-field">
            <span>Section</span>
            <select id="props-category">
              <option value="">All sections</option>
              {categories.map((category) => <option value={category}>{category}</option>)}
            </select>
          </label>
          <label class="props-field">
            <span>Stated decade</span>
            <select id="props-decade">
              <option value="">Any decade</option>
              {decades.map((decade) => <option value={decade}>{decade}s</option>)}
            </select>
          </label>
        </form>
        <details id="props-scene" class="props-scene">
          <summary>Paste a scene to find props (AI)</summary>
          <form id="scene-form" class="scene-form" data-api-url={apiUrl}>
            <label class="props-field">
              <span>Scene text</span>
              <textarea id="scene-text" rows="8" maxlength="4000" placeholder="Paste up to 4,000 characters of a scene, e.g. INT. DINER - NIGHT. A waitress pours coffee while the detective drops his badge on the counter." disabled={!apiUrl}></textarea>
            </label>
            <p class="props-note"><span id="scene-count">0</span> / 4,000 characters</p>
            <label class="props-field scene-period">
              <span>Time period or setting (optional)</span>
              <input id="scene-period" type="text" maxlength="40" placeholder="1960s, WWII, present day" autocomplete="off" disabled={!apiUrl} />
            </label>
            <p class="props-note scene-disclosure">Your text is sent to Cloudflare Workers AI to pick props from this catalog. This site doesn't store or log it. AI can be wrong, so check each item in the catalog.</p>
            {!apiUrl && <p class="scene-off">AI scene matching isn't switched on yet. Keyword search works.</p>}
            <button id="scene-submit" type="submit" class="props-button" disabled={!apiUrl}>Find props for this scene</button>
          </form>
          <p id="scene-status" class="scene-status" aria-live="polite" hidden></p>
          <div id="scene-results" class="scene-results"></div>
        </details>
        <p id="props-count" class="props-count" aria-live="polite">{cards.length} items, listed alphabetically</p>
        <noscript><p class="props-note">Search needs JavaScript. All {cards.length} items are listed below alphabetically.</p></noscript>
        <p id="props-empty" class="props-empty" hidden></p>
        <ol id="props-results" class="props-results">
          {cards.map((card) => (
            <li class="prop-card" data-key={card.key} data-categories={card.categories.join("|")} data-decades={card.decades.join(" ")} data-order={card.order}>
              {card.thumb && <img class="prop-thumb" src={card.thumb.src} width={card.thumb.width} height={card.thumb.height} alt={card.description} loading="lazy" decoding="async" />}
              <p class="prop-line">
                <span class="prop-vendor">{card.vendorName}</span> · <span class="prop-ids">{card.ids}</span> · <span class="prop-name">{card.name}</span>{card.era && <> · <span class="prop-era">{card.era}</span></>} · <span class="prop-page">{card.pageText}</span>
              </p>
              <p class="prop-category">{card.categories.join(" · ")}</p>
              {card.tags.length > 0 && (
                <p class="prop-tags">AI-suggested search terms: <span class="prop-tag-list">{card.tags.join(", ")}</span></p>
              )}
              {card.thumb && <p class="prop-photo">Photo: {card.vendorName} catalog</p>}
              <p class="prop-actions">
                <a href={card.catalogHref} target="_blank" rel="noopener noreferrer">{card.catalogLabel}</a>
                <a href={card.formUrl} target="_blank" rel="noopener noreferrer">Inquire</a>
              </p>
              <p class="prop-cite">When you inquire, cite {card.ids} · {card.name} · {card.pageText}</p>
            </li>
          ))}
        </ol>
        <button id="props-more" type="button" class="props-more" hidden>Show more</button>
      </section>

      {vendorBoxes.map(({ vendor, catalogs: vendorCatalogs }) => (
        <section class="props-box props-vendor">
          <h2 class="props-vendor-name">{vendor.name}</h2>
          {vendorCatalogs.map((catalog) => (
            <p class="props-catalog">{catalog.title} (version {catalog.version}, {catalog.pageCount} pages){catalog.indexedAt && ` · indexed ${catalog.indexedAt}`} · <a href={catalog.sourceUrl} target="_blank" rel="noopener noreferrer">Open catalog on Google Drive</a></p>
          ))}
          <p class="props-contact">Rental inquiries: <a href={vendor.contact.formUrl} target="_blank" rel="noopener noreferrer">official contact form</a> · <a href={`mailto:${vendor.contact.email}`}>{vendor.contact.email}</a> · <a href={vendor.contact.hubUrl} target="_blank" rel="noopener noreferrer">vendor links</a></p>
          <p class="props-note">{vendor.inquiryHint} Contact details as published in the catalog (page 3) and on the vendor's Linktree.</p>
        </section>
      ))}

      <p class="props-footer">Prop owners: want your inventory listed, corrected or removed? <a href="/#contact">Contact us</a>. Know another Pittsburgh prop source? <a href="/#contact">Let us know</a>.</p>
      <p class="props-byline"><a href="/">A Cookies &amp; Comedy Film Festival project</a></p>
    </div>

    <script>
      import { buildIndex, parseDecades, search } from "../scripts/props-search.js";
      import { checkSceneText, eraNote, keepKnownKeys, requestScene } from "../scripts/props-scene.js";

      const PAGE_SIZE = 24;
      const list = document.getElementById("props-results") as HTMLOListElement;
      const query = document.getElementById("props-query") as HTMLInputElement;
      const category = document.getElementById("props-category") as HTMLSelectElement;
      const decade = document.getElementById("props-decade") as HTMLSelectElement;
      const count = document.getElementById("props-count") as HTMLElement;
      const empty = document.getElementById("props-empty") as HTMLElement;
      const more = document.getElementById("props-more") as HTMLButtonElement;
      const form = document.getElementById("props-form") as HTMLFormElement;

      const docs = [...list.querySelectorAll<HTMLElement>(".prop-card")].map((card) => {
        const name = card.querySelector(".prop-name")!.textContent ?? "";
        const era = card.querySelector(".prop-era")?.textContent ?? "";
        return {
          card,
          key: card.dataset.key!,
          name,
          description: `${name} ${era}`,
          categories: card.dataset.categories!.split("|"),
          tags: card.querySelector(".prop-tag-list")?.textContent?.split(", ") ?? [],
          decades: card.dataset.decades ? card.dataset.decades.split(" ").map(Number) : [],
          order: Number(card.dataset.order),
        };
      });
      const index = buildIndex(docs);
      let results = docs;
      let shown = PAGE_SIZE;

      function render() {
        const visible = new Set(results.slice(0, shown));
        const matched = new Set(results);
        list.replaceChildren(...results.map((doc) => doc.card), ...docs.filter((doc) => !matched.has(doc)).map((doc) => doc.card));
        for (const doc of docs) doc.card.hidden = !visible.has(doc);
        more.hidden = results.length <= shown;
        const text = query.value.trim();
        empty.hidden = results.length > 0;
        empty.textContent = text
          ? `No catalog items matched “${text}”. Try fewer or simpler words, or clear the filters.`
          : "No items match these filters. Clear a filter to see more.";
        const filtered = text || category.value || decade.value;
        count.textContent = filtered
          ? `${results.length} matching ${results.length === 1 ? "item" : "items"}${results.length > shown ? `, showing ${shown}` : ""}`
          : `${docs.length} items, listed alphabetically${results.length > shown ? `, showing ${shown}` : ""}`;
      }

      function update() {
        results = search(index, query.value, { category: category.value, decade: decade.value });
        shown = PAGE_SIZE;
        render();
      }

      let timer: ReturnType<typeof setTimeout> | undefined;
      query.addEventListener("input", () => {
        clearTimeout(timer);
        timer = setTimeout(update, 120);
      });
      form.addEventListener("submit", (event) => event.preventDefault());
      category.addEventListener("change", update);
      decade.addEventListener("change", update);
      more.addEventListener("click", () => {
        shown += PAGE_SIZE;
        render();
      });
      render();

      const sceneForm = document.getElementById("scene-form") as HTMLFormElement;
      const sceneText = document.getElementById("scene-text") as HTMLTextAreaElement;
      const scenePeriod = document.getElementById("scene-period") as HTMLInputElement;
      const sceneCount = document.getElementById("scene-count") as HTMLElement;
      const sceneSubmit = document.getElementById("scene-submit") as HTMLButtonElement;
      const sceneStatus = document.getElementById("scene-status") as HTMLElement;
      const sceneResults = document.getElementById("scene-results") as HTMLElement;
      const apiUrl = sceneForm.dataset.apiUrl ?? "";
      const cardsByKey = new Map(docs.map((doc) => [doc.key, doc.card]));

      function showStatus(text: string) {
        sceneStatus.textContent = text;
        sceneStatus.hidden = !text;
      }

      function element(tag: string, className: string, text?: string) {
        const node = document.createElement(tag);
        node.className = className;
        if (text !== undefined) node.textContent = text;
        return node;
      }

      function searchFor(prop: string) {
        query.value = prop;
        category.value = "";
        decade.value = "";
        update();
        list.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      function propBlock(entry: { prop: string; reason: string; keys: string[] }, periodDecades: Set<number>) {
        const block = element("div", "scene-prop");
        block.append(element("h4", "scene-prop-name", entry.prop));
        if (entry.reason) block.append(element("p", "scene-reason", `AI: ${entry.reason}`));
        if (entry.keys.length) {
          const matches = element("ol", "props-results scene-matches");
          for (const key of entry.keys) {
            const copy = cardsByKey.get(key)!.cloneNode(true) as HTMLElement;
            copy.hidden = false;
            const note = eraNote(periodDecades, (copy.dataset.decades ?? "").split(" ").filter(Boolean).map(Number));
            if (note) copy.querySelector(".prop-line")!.after(element("p", "scene-era-note", note));
            matches.append(copy);
          }
          block.append(matches);
        } else {
          const missing = element("p", "scene-missing", "No matching item found. ");
          const link = element("button", "scene-search-link", `Search the catalog for “${entry.prop}”`) as HTMLButtonElement;
          link.type = "button";
          link.addEventListener("click", () => searchFor(entry.prop));
          missing.append(link);
          block.append(missing);
        }
        return block;
      }

      function group(title: string, entries: { prop: string; reason: string; keys: string[] }[], periodDecades: Set<number>) {
        const section = element("div", "scene-group");
        section.append(element("h3", "scene-group-title", title));
        if (!entries.length) section.append(element("p", "props-note", "None listed."));
        for (const entry of entries) section.append(propBlock(entry, periodDecades));
        return section;
      }

      const MESSAGES: Record<string, string> = {
        rate_limited: "Too many requests right now. Wait a minute and try again.",
        busy: "The AI service is busy. Try again in a minute.",
        unavailable: "AI matching isn't available right now. Keyword search still works.",
        timeout: "AI matching didn't work this time. Keyword search still works. Try again later.",
        network: "AI matching didn't work this time. Keyword search still works. Try again later.",
        error: "AI matching didn't work this time. Keyword search still works. Try again later.",
      };

      sceneText.addEventListener("input", () => {
        sceneCount.textContent = sceneText.value.trim().length.toLocaleString("en-US");
      });

      sceneForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!apiUrl) return;
        const problem = checkSceneText(sceneText.value, scenePeriod.value);
        if (problem) {
          showStatus(problem);
          return;
        }
        sceneSubmit.disabled = true;
        sceneResults.replaceChildren();
        showStatus("Matching props… this can take up to about 30 seconds for long scenes.");
        const period = scenePeriod.value;
        const state = await requestScene(apiUrl, sceneText.value, { period });
        sceneSubmit.disabled = false;
        if (state.kind === "ok") {
          const kept = keepKnownKeys(state, new Set(cardsByKey.keys()));
          if (!kept.required.length && !kept.optional.length) {
            showStatus("The AI didn't identify props in this text.");
            return;
          }
          showStatus("");
          const periodDecades = parseDecades(period);
          sceneResults.append(group("Required by the scene", kept.required, periodDecades), group("Optional set dressing", kept.optional, periodDecades));
          const notes = [
            "Props not listed above were not identified or have no match in this catalog; try keyword search for them.",
            `Matched by AI (${kept.model}). AI can be wrong; check each item in the catalog and confirm availability with the vendor.`,
          ];
          if (kept.ignored) notes.push(`${kept.ignored} AI ${kept.ignored === 1 ? "suggestion referred to an item that doesn't" : "suggestions referred to items that don't"} exist and ${kept.ignored === 1 ? "was" : "were"} ignored.`);
          for (const note of notes) sceneResults.append(element("p", "props-note", note));
          return;
        }
        if (state.kind === "quota") {
          const local = state.resetsAt ? ` (about ${new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit", timeZoneName: "short" }).format(state.resetsAt)})` : "";
          showStatus(`Today's AI matching budget is used up. Keyword search still works. AI matching resets at midnight UTC${local}.`);
          return;
        }
        showStatus(state.kind === "invalid" ? state.message ?? "Check the scene text and try again." : MESSAGES[state.kind]);
      });
    </script>

    {demo && <style is:inline set:html={DEMO_STYLES}></style>}
    <style is:global>
      .props-page {
        --pp-paper: #f5f6f7;
        --pp-surface: #ffffff;
        --pp-ink: #000000;
        --pp-muted: #4b5157;
        --pp-rule: #d5d8dc;
        --pp-field: #767c83;
        --pp-gold: #ffb612;
        margin: 0;
        background-color: var(--pp-paper);
        color: var(--pp-ink);
        font-family: "Inter Variable", "Inter", system-ui, sans-serif;
        font-size: 15px;
        font-weight: 400;
        line-height: 1.5;
      }

      .props-page [hidden] {
        display: none !important;
      }

      .props-page .props-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px 32px 40px;
      }

      .props-page h1,
      .props-page h2,
      .props-page h3,
      .props-page h4 {
        font-family: inherit;
        color: var(--pp-ink);
        letter-spacing: normal;
        line-height: 1.25;
        margin: 0;
      }

      .props-page a {
        color: var(--pp-ink);
        font-weight: inherit;
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 2px;
        transition: none;
      }

      .props-page a::after {
        display: none;
      }

      .props-page strong {
        color: var(--pp-ink);
        font-weight: 700;
      }

      .props-page a:hover {
        color: var(--pp-ink);
        text-decoration-thickness: 2px;
      }

      .props-page :is(a, button, input, select, textarea, summary):focus {
        box-shadow: none;
      }

      .props-page :is(a, button, input, select, textarea, summary):focus-visible {
        outline: 3px solid var(--pp-ink);
        outline-offset: 2px;
      }

      .props-page .props-header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 4px 24px;
        padding: 0 0 16px;
        margin: 0 0 20px;
        border-bottom: 2px solid var(--pp-ink);
      }

      .props-page .props-title {
        font-size: 28px;
        font-weight: 750;
        letter-spacing: -0.01em;
      }

      .props-page .props-subtitle {
        flex-basis: 100%;
        order: 3;
        margin: 0;
        color: var(--pp-muted);
      }

      .props-page .props-back {
        font-size: 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        min-height: 44px;
      }

      .props-page .props-box {
        background-color: var(--pp-surface);
        border: 1px solid var(--pp-rule);
        border-radius: 2px;
        box-shadow: none;
        padding: 16px 20px;
        margin: 0 0 20px;
        transition: none;
      }

      .props-page .props-box p {
        margin: 0 0 8px;
        max-width: 78ch;
      }

      .props-page .props-box p:last-child {
        margin-bottom: 0;
      }

      .props-page .props-search.props-box {
        background: none;
        border: 0;
        padding: 0;
      }

      .props-page .props-note,
      .props-page .props-count {
        color: var(--pp-muted);
        font-size: 13px;
        font-variant-numeric: tabular-nums;
      }

      .props-page .props-controls {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
        gap: 12px;
        padding: 12px;
        margin: 0 0 12px;
        background-color: var(--pp-surface);
        border: 1px solid var(--pp-rule);
        border-radius: 2px;
      }

      .props-page .props-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: 13px;
        font-weight: 600;
        color: var(--pp-ink);
      }

      .props-page .props-field input,
      .props-page .props-field select,
      .props-page .props-field textarea {
        font: inherit;
        font-size: 15px;
        font-weight: 400;
        min-height: 44px;
        padding: 8px 12px;
        border: 1px solid var(--pp-field);
        border-radius: 2px;
        background-color: var(--pp-surface);
        color: var(--pp-ink);
      }

      .props-page .props-field input::placeholder,
      .props-page .props-field textarea::placeholder {
        color: var(--pp-muted);
        opacity: 1;
      }

      .props-page .props-scene {
        background-color: var(--pp-surface);
        border: 1px solid var(--pp-rule);
        border-radius: 2px;
        padding: 0 16px;
        margin: 0 0 16px;
      }

      .props-page .props-scene[open] {
        padding-bottom: 16px;
      }

      .props-page .props-scene summary {
        display: flex;
        align-items: center;
        min-height: 44px;
        cursor: pointer;
        font-weight: 650;
      }

      .props-page .scene-form {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 4px;
      }

      .props-page .scene-form textarea {
        resize: vertical;
      }

      .props-page .scene-period {
        max-width: 360px;
      }

      .props-page .scene-era-note {
        font-size: 13px;
        font-weight: 600;
        color: var(--pp-ink);
      }

      .props-page .scene-off,
      .props-page .scene-status {
        margin: 8px 0 0;
        font-weight: 600;
      }

      .props-page .props-button,
      .props-page .props-more {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 20px;
        border: 1px solid var(--pp-ink);
        border-radius: 2px;
        background-color: var(--pp-ink);
        color: var(--pp-surface);
        font: inherit;
        font-size: 15px;
        font-weight: 600;
        box-shadow: none;
        cursor: pointer;
      }

      .props-page .props-button {
        align-self: flex-start;
      }

      .props-page .props-button:disabled {
        border-color: var(--pp-rule);
        background-color: #e3e5e8;
        color: var(--pp-muted);
        cursor: not-allowed;
      }

      .props-page .props-more {
        margin: 16px auto 0;
        display: flex;
      }

      .props-page .props-count {
        margin: 0 0 8px;
      }

      .props-page .props-empty {
        margin: 12px 0;
        padding: 12px 16px;
        background-color: var(--pp-surface);
        border: 1px solid var(--pp-rule);
        border-radius: 2px;
      }

      .props-page .props-results {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
