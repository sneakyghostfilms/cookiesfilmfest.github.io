---
import "../styles/index.css";
import "@fontsource-variable/inter";
import "../styles/props.css";
import vendorsData from "../data/props/vendors.json";
import inventory from "../data/props/inventory.json";
import tagsData from "../data/props/tags.json";
import propsConfig from "../data/props/config.json";
import { DEMO_STYLES, privateVendorsFor, readDemoManifest } from "../../scripts/props/demo-links.mjs";
import { NOT_AFFILIATED, cardFor, catalogLines, contactRoutes, privateFacts, socialLinks, specialtiesLine, vendorBadges, vendorFacts, vendorSearchDoc, vendorSources } from "../scripts/props-cards.js";
import { compareByName } from "../scripts/props-search.js";

const { generator } = Astro;
const apiUrl: string = import.meta.env.PUBLIC_PROPS_API_URL || propsConfig.apiUrl;
const description = "Search Pittsburgh prop rental catalogs in plain English, with item numbers, catalog pages and how to inquire.";
const demoMode = process.env.PROPS_DEMO === "1";
const demo = demoMode ? readDemoManifest() : null;
const privateVendors = privateVendorsFor(process.env);

const catalogs = new Map(
  vendorsData.vendors.flatMap((vendor) => vendor.catalogs.map((catalog) => [catalog.id, { catalog, vendor }])),
);
const tags = tagsData.tags as Record<string, string[]>;

const cards = inventory.items
  .map((item, order) => ({ ...item, order }))
  .sort(compareByName)
  .map((item) => {
    const { catalog, vendor } = catalogs.get(item.catalog)!;
    return { ...cardFor(item, { vendor, catalog, tags: tags[item.key] ?? [], demoEntry: demo?.items?.[item.key] ?? null }), order: item.order };
  });

const categories = [...new Set(inventory.items.flatMap((item) => item.categories))].sort();
const decades = [...new Set(inventory.items.flatMap((item) => item.decades))].sort((a, b) => a - b);
const itemCounts = new Map<string, number>();
for (const item of inventory.items) itemCounts.set(item.catalog, (itemCounts.get(item.catalog) ?? 0) + 1);
const vendorsWithItems = vendorsData.vendors.filter((vendor) => inventory.items.some((item) => item.vendor === vendor.id));
const byName = (a: { name: string }, b: { name: string }) => a.name.localeCompare(b.name, "en");
const vendorsWithoutItems = vendorsData.vendors.filter((vendor) => !vendorsWithItems.includes(vendor)).sort(byName);
const indexed = inventory.catalogs as Record<string, { indexedAt: string; capturedAt?: string }>;
const vendorBoxes = [...[...vendorsWithItems].sort(byName), ...vendorsWithoutItems].map((vendor) => ({
  vendor,
  badges: vendorBadges(vendor),
  facts: vendorFacts(vendor),
  routes: contactRoutes(vendor.contact),
  social: socialLinks(vendor.social),
  sources: vendorSources(vendor),
  private: privateFacts(privateVendors?.[vendor.id]),
  catalogs: catalogLines(vendor, { indexed, itemCounts }),
}));
const vendorMatches = vendorsWithoutItems.map((vendor, order) => ({
  vendor,
  doc: vendorSearchDoc(vendor, order),
  badges: vendorBadges(vendor),
  specialties: specialtiesLine(vendor),
  route: contactRoutes(vendor.contact)[0] ?? null,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta name="generator" content={generator} />

    <title>Pittsburgh Prop Search | Cookies and Comedy Film Festival</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Pittsburgh Prop Search" />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />

  </head>
  <body class="props-page">
    <div class="props-wrap">
      <header class="props-header">
        <h1 class="props-title">Pittsburgh Prop Search</h1>
        <p class="props-subtitle">Search local prop rental catalogs in plain English.</p>
        <a href="/" class="props-back">Back to Main Site</a>
        {demoMode && <p class="props-demo-marker"><span>Local demo, not public</span></p>}
        {privateVendors && <p class="props-demo-marker"><span>Private vendor notes visible: do not screenshare</span></p>}
      </header>

      <section class="props-box props-about">
        <p>A discovery tool for Pittsburgh filmmakers. It does not book rentals or show live availability. <strong>Always confirm availability, condition, sizes and price with the vendor.</strong> Names, item numbers, eras and pages are copied from each vendor's catalog or website. {NOT_AFFILIATED} Keyword search runs in your browser.</p>
        <p class="props-contact"><a href="#prop-sources">{vendorBoxes.length} prop sources are listed below</a> with the contact details they publish; {vendorsWithItems.length} {vendorsWithItems.length === 1 ? "has" : "have"} searchable inventory.</p>
      </section>

      <section class="props-box props-search">
        <form id="props-form" class="props-controls" role="search">
          <label class="props-field props-query">
            <span>Search props</span>
            <input id="props-query" type="search" placeholder="e.g. rotary phone, police jacket, 60s office" autocomplete="off" />
          </label>
          <label class="props-field">
            <span>Section</span>
            <select id="props-category">
              <option value="">All sections</option>
              {categories.map((category) => <option value={category}>{category}</option>)}
            </select>
          </label>
          {vendorsWithItems.length > 1 && (
            <label class="props-field">
              <span>Vendor</span>
              <select id="props-vendor">
                <option value="">All vendors</option>
                {vendorsWithItems.map((vendor) => <option value={vendor.id}>{vendor.name}</option>)}
              </select>
            </label>
          )}
          <label class="props-field">
            <span>Stated decade</span>
            <select id="props-decade">
              <option value="">Any decade</option>
              {decades.map((decade) => <option value={decade}>{decade}s</option>)}
            </select>
          </label>
        </form>
        <details id="props-scene" class="props-scene">
          <summary>Paste a scene to find props (AI)</summary>
          <form id="scene-form" class="scene-form" data-api-url={apiUrl}>
            <label class="props-field">
              <span>Scene text</span>
              <textarea id="scene-text" rows="8" maxlength="4000" placeholder="Paste up to 4,000 characters of a scene, e.g. INT. DINER - NIGHT. A waitress pours coffee while the detective drops his badge on the counter." disabled={!apiUrl}></textarea>
            </label>
            <p class="props-note"><span id="scene-count">0</span> / 4,000 characters</p>
            <label class="props-field scene-period">
              <span>Time period or setting (optional)</span>
              <input id="scene-period" type="text" maxlength="40" placeholder="1960s, WWII, present day" autocomplete="off" disabled={!apiUrl} />
            </label>
            <p class="props-note scene-disclosure">Your text is sent to Cloudflare Workers AI to pick props from these catalogs. This site doesn't store or log it. AI can be wrong, so check each item with its vendor.</p>
            {!apiUrl && <p class="scene-off">AI scene matching isn't switched on yet. Keyword search works.</p>}
            <button id="scene-submit" type="submit" class="props-button" disabled={!apiUrl}>Find props for this scene</button>
          </form>
          <p id="scene-status" class="scene-status" aria-live="polite" hidden></p>
          <div id="scene-results" class="scene-results"></div>
        </details>
        {vendorMatches.length > 0 && (
          <section id="props-vendor-matches" class="vendor-matches" hidden>
            <h2 class="vendor-matches-title">Prop sources that match this search; inventory not indexed</h2>
            <ul class="vendor-match-list">
              {vendorMatches.map(({ vendor, doc, badges, specialties, route }) => (
                <li class="vendor-match" data-vendor={vendor.id} data-name={doc.name} data-specialties={doc.description} hidden>
                  <p class="vendor-match-line"><a class="vendor-match-name" href={`#vendor-${vendor.id}`}>{vendor.name}</a>{badges.map((badge) => <span class:list={["props-badge", { "props-badge-regional": badge.regional }]}>{badge.text}</span>)}</p>
                  {specialties && <p class="props-note">{specialties}</p>}
                  <p class="props-note">Inventory not indexed; contact the vendor{route && <>: <a href={route.href} {...(route.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{route.label}</a></>}.</p>
                </li>
              ))}
            </ul>
          </section>
        )}
        <p id="props-count" class="props-count" aria-live="polite">{cards.length} items, listed alphabetically</p>
        <noscript><p class="props-note">Search needs JavaScript. All {cards.length} items are listed below alphabetically.</p></noscript>
        <p id="props-empty" class="props-empty" hidden></p>
        <ol id="props-results" class="props-results">
          {cards.map((card) => (
            <li class="prop-card" data-key={card.key} data-vendor={card.vendorId} data-categories={card.categories.join("|")} data-decades={card.decades.join(" ")} data-order={card.order}>
              {card.thumb && <img class="prop-thumb" src={card.thumb.src} width={card.thumb.width} height={card.thumb.height} alt={card.alt} loading="lazy" decoding="async" />}
              <p class="prop-line">
                <span class="prop-vendor">{card.vendorName}</span>{card.ids && <> · <span class="prop-ids">{card.ids}</span></>} · <span class="prop-name">{card.name}</span>{card.era && <> · <span class="prop-era">{card.era}</span></>}{card.pages && <> · <span class="prop-page">{card.pages}</span></>}
              </p>
              {card.categories.length > 0 && <p class="prop-category">{card.categories.join(" · ")}</p>}
              {card.tags.length > 0 && (
                <p class="prop-tags">AI-suggested search terms: <span class="prop-tag-list">{card.tags.join(", ")}</span></p>
              )}
              {card.photoCredit && <p class="prop-photo">{card.photoCredit}</p>}
              <p class="prop-actions">
                <a href={card.link.href} target="_blank" rel="noopener noreferrer">{card.link.label}</a>
                {card.inquire && <a href={card.inquire} target="_blank" rel="noopener noreferrer">Inquire</a>}
              </p>
              <p class="prop-cite">{card.cite}</p>
            </li>
          ))}
        </ol>
        <button id="props-more" type="button" class="props-more" hidden>Show more</button>
      </section>

      <h2 id="prop-sources" class="props-sources-title">Prop sources ({vendorBoxes.length})</h2>
      {vendorBoxes.map(({ vendor, badges, facts, routes, social, sources, private: privateLines, catalogs: vendorCatalogs }) => (
        <section class="props-box props-vendor" id={`vendor-${vendor.id}`} data-vendor={vendor.id}>
          <h2 class="props-vendor-name">{vendor.name}</h2>
          {badges.length > 0 && <p class="props-badges">{badges.map((badge) => <span class:list={["props-badge", { "props-badge-regional": badge.regional }]}>{badge.text}</span>)}</p>}
          {vendorCatalogs.map((line) => (
            <p class="props-catalog">{line.text}{line.href && <a href={line.href} target="_blank" rel="noopener noreferrer">{line.linkLabel}</a>}</p>
          ))}
          <p class="props-contact">Inquiries: {routes.map((route, position) => (
            <>{position > 0 && " · "}<a href={route.href} {...(route.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{route.label}</a></>
          ))}{social.map((link) => <> · <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></>)}</p>
          {facts.map((fact) => <p class="props-note">{fact}</p>)}
          <p class="props-note props-vendor-sources">Details as the vendor publishes them, last checked {vendor.lastVerified}: {sources.map((source, position) => (
            <>{position > 0 && " · "}{source.href ? <a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a> : source.label}</>
          ))}.</p>
          {privateLines.length > 0 && (
            <div class="props-vendor-private">
              <p class="props-note">Private, local demo only:</p>
              {privateLines.map((line) => <p class="props-note">{line}</p>)}
            </div>
          )}
        </section>
      ))}

      <p class="props-footer">Prop owners: want your inventory listed, corrected or removed? <a href="/#contact">Contact us</a>. Know another Pittsburgh prop source? <a href="/#contact">Let us know</a>.</p>
      <p class="props-byline"><a href="/">A Cookies &amp; Comedy Film Festival project</a></p>
    </div>

    <script>import "../scripts/props-page.ts";</script>

    {demoMode && <style is:inline set:html={DEMO_STYLES}></style>}
  </body>
</html>
