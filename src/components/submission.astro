---
import SectionLayout from "../layouts/section-layout.astro";
---

<SectionLayout title="Film Submission" id="submission">
  <Fragment slot="content">
    <!-- Submission Content -->
    <div class="submission-content">
      <div class="submissions-open-banner">
        <h2>Submissions Open</h2>
        <p class="submissions-notice">Submissions are now open for the 2027 festival, returning to the Harris Theater on Saturday, March 13, 2027.</p>
      </div>
      <div class="mb-8 flex justify-center">
        <a href="https://filmfreeway.com/CookiesFilmFest" target="_blank" rel="noopener noreferrer" class="submission-button-link" title="Submit on FilmFreeway">
          <img src="https://public-assets.filmfreeway.com/submission_buttons/v2/med_submission_btn@2x-sky-gradient.png" alt="Submit on FilmFreeway" width="263" height="102">
        </a>
      </div>
      <h2 class="subheader-orange">Submission Guidelines:</h2>
      <div class="text-left">
        <ul class="list-disc pl-6 space-y-4 mb-8">
          <li><strong>Genre:</strong> Films must be primarily comedy.</li>
          <li><strong>Completion Date:</strong> Films should have been completed on or after January 1, 2025.</li>
          <li><strong>Language:</strong> Non-English films must include English subtitles.</li>
          <li><strong>Length:</strong> Films should not exceed 20 minutes.</li>
          <li><strong>Local Eligibility:</strong> To be considered local, at least half the film must have been created within an hour of Pittsburgh.</li>
          <li><strong>Awards:</strong> Selected films will be considered for festival awards. Award categories will be announced closer to the event.</li>
          <li><strong>AI &amp; Synthetic Media:</strong> <button type="button" id="ai-policy-open" class="policy-link">Click to view our AI policy</button></li>
        </ul>
      </div>
    </div>

    <dialog id="ai-policy-dialog" class="policy-dialog" aria-labelledby="ai-policy-title">
      <button type="button" class="policy-dialog-close" aria-label="Close" data-close>&times;</button>
      <div class="policy-dialog-body">
        <h3 id="ai-policy-title" class="policy-dialog-title">AI &amp; Synthetic Media Policy (2027)</h3>
        <p class="policy-intro">
          The Cookies & Comedy Film Festival recognizes that AI tools are increasingly part of modern filmmaking workflows. Rather than attempting to regulate every possible use, the festival is making a focused, pragmatic choice about character and performance.
        </p>

        <div class="policy-restrictions">
          <h4 class="policy-subheader">The following are not permitted:</h4>
          <ul class="list-disc pl-6 space-y-3">
            <li><strong>AI-generated characters</strong>, including foreground or background characters. This includes AI-generated faces, bodies, voices, or performances intended to function as characters in the film.</li>
            <li><strong>Synthetic replicas of real people</strong> (voice or likeness) without explicit consent from the individual depicted (and legal guardians where applicable).</li>
          </ul>
        </div>

        <p class="policy-purpose">
          This policy prioritizes human performance and authorship, and is intentionally aligned with evolving labor protections for performers and creators.
        </p>

        <div class="policy-notes">
          <p class="policy-disclaimer">As labor organizations such as SAG-AFTRA establish clearer standards, consent models, and compensation frameworks for AI-generated character usage, the festival will revisit this policy accordingly.</p>
        </div>
      </div>
    </dialog>
  </Fragment>
</SectionLayout>

<script>
  const dialog = document.getElementById("ai-policy-dialog") as HTMLDialogElement | null;

  document.getElementById("ai-policy-open")?.addEventListener("click", () => dialog?.showModal());

  dialog?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target === dialog || target.closest("[data-close]")) dialog.close();
  });
</script>

<style>
  /* .subheader-orange now handled globally */

  /* Banner Styling */
  .submissions-open-banner {
    background-color: rgba(255, 255, 255, 0.4);
    color: var(--color-secondary);
    text-align: center;
    padding: 1.5rem 1.5rem 2rem 1.5rem;
    border-radius: 1rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-md);
    border: 1px solid rgba(215, 155, 88, 0.1);
    transition: all 0.3s ease;
  }

  .submissions-open-banner h2 {
    font-size: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-secondary);
    text-shadow: none;
  }
  
  .submissions-notice {
    font-size: 1.1rem;
    margin: 0;
    color: var(--color-text);
  }

  /* Submission Content */
  .submission-content {
    /* No special styling needed when enabled */
  }

  .submission-button-link {
    display: inline-flex;
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .submission-button-link:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
  }

  /* Remove the previous submission-closed-tag */
  .submissions-closed-tag {
    display: none;
  }

  @media (min-width: 768px) {
    /* No special styles needed */
  }

  /* AI Policy */
  .policy-link {
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    font-weight: 600;
    color: var(--color-secondary);
    text-decoration: underline;
    text-decoration-color: var(--color-primary);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .policy-link:hover {
    color: var(--color-primary-dark);
  }

  .policy-dialog {
    width: 90%;
    max-width: 640px;
    margin: auto;
    padding: 0;
    border: none;
    border-radius: 1rem;
    background: #fbe3c4;
    color: var(--color-secondary);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }

  .policy-dialog[open] {
    animation: policyDialogIn 0.3s ease;
  }

  .policy-dialog::backdrop {
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  @keyframes policyDialogIn {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  :global(body:has(.policy-dialog[open])) {
    overflow: hidden;
  }

  .policy-dialog-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    background: none;
    border: none;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-secondary);
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .policy-dialog-close:hover {
    color: var(--color-primary-dark);
  }

  .policy-dialog-close:focus:not(:focus-visible) {
    box-shadow: none;
  }

  .policy-dialog-body {
    max-height: 85vh;
    overflow-y: auto;
    padding: 2rem;
    text-align: left;
  }

  .policy-dialog-title {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0 2.5rem 1rem 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .policy-dialog[open] {
      animation: none;
    }
  }

  .policy-intro {
    margin-bottom: 1.25rem;
    line-height: 1.7;
  }

  .policy-restrictions {
    background-color: rgba(215, 155, 88, 0.1);
    padding: 1.25rem 1.5rem;
    border-radius: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .policy-subheader {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-secondary);
    margin-bottom: 0.75rem;
  }

  .policy-purpose {
    margin-bottom: 1.25rem;
    font-style: italic;
  }

  .policy-notes {
    padding-top: 1rem;
    border-top: 1px solid rgba(215, 155, 88, 0.3);
  }

  .policy-notes p {
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .policy-disclaimer {
    color: var(--color-text-light);
    font-style: italic;
  }
</style>
