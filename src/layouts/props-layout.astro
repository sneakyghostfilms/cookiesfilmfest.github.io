---
import "../styles/index.css";
import "@fontsource-variable/inter";
import "@fontsource/league-gothic";
import "../styles/props.css";
import { DEMO_STYLES } from "../../scripts/props/demo-links.mjs";
import { NOT_AFFILIATED } from "../scripts/props-cards.js";

// The frame the props pages share: the head, the masthead with the demo markers and the tabs, the sheet each page
// fills, the "About this tool" box with the disclosures, the vendor opt-out line and the byline. A page adds its own
// masthead markers through the named slot.
export interface Props {
  title: string;
  description: string;
  current: "keyword" | "scene" | "sources";
}

// The tabs are the one way between the three pages; the current one is named, not linked.
const PAGES = [
  { id: "keyword", href: "/props", label: "Search by keyword" },
  { id: "scene", href: "/props/scene", label: "Paste a scene" },
  { id: "sources", href: "/props/sources", label: "Prop sources" },
];
const { title, description, current } = Astro.props;
const { generator } = Astro;
const demoMode = process.env.PROPS_DEMO === "1";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta name="generator" content={generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Pittsburgh Prop Search" />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />

  </head>
  <body class="props-page">
    <div class="props-wrap">
      <header class="props-header">
        <h1 class="props-title">Pittsburgh Prop Search</h1>
        <a href="/" class="props-back">Back to main site</a>
        <p class="props-subtitle">Local prop rental catalogs, searchable in plain English.</p>
        {demoMode && <p class="props-demo-marker"><span>Local demo, not public</span></p>}
        <slot name="markers" />
        <nav class="props-nav" aria-label="Prop search pages">{PAGES.map((page) => (
          page.id === current ? <span aria-current="page">{page.label}</span> : <a href={page.href}>{page.label}</a>
        ))}</nav>
      </header>

      <main class="props-sheet">
        <slot />
      </main>

      <section class="props-about">
        <h2 class="props-about-title">About this tool</h2>
        <div class="props-about-text">
          <p>A discovery tool for Pittsburgh filmmakers. It does not book rentals or show live availability. {NOT_AFFILIATED}</p>
          <p>Names, item numbers, eras and pages are copied from each vendor's catalog or website. <strong>Always confirm availability, condition, sizes and price with the vendor.</strong> When you inquire, cite the item number and page, or the item's page link.</p>
          <p>Keyword search runs in your browser. Keyword search also matches search terms an AI suggested for each item.</p>
        </div>
      </section>

      <p class="props-footer">Prop owners: want your inventory listed, corrected or removed? <a href="/#contact">Contact us</a>. Know another Pittsburgh prop source? <a href="/#contact">Let us know</a>.</p>
      <p class="props-byline"><a href="/">A Cookies &amp; Comedy Film Festival project</a></p>
    </div>

    {demoMode && <style is:inline set:html={DEMO_STYLES}></style>}
  </body>
</html>
