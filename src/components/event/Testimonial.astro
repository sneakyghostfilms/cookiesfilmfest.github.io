---
interface Props {
  quote?: string;
  videoId?: string;
  author: string;
  context?: string;
}

const { quote, videoId, author, context } = Astro.props;
---

<div class:list={["testimonial", { "testimonial-with-video": videoId }]}>
  {videoId && (
    <div class="testimonial-video">
      <iframe
        src={`https://www.youtube.com/embed/${videoId}`}
        title={`Interview with ${author}`}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
  )}
  {quote && <p class="testimonial-quote">"{quote}"</p>}
  <div class="testimonial-footer">
    <p class="testimonial-attribution">{author}</p>
    {context && <p class="testimonial-context">{context}</p>}
  </div>
</div>

<style>
  .testimonial {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid rgba(50, 34, 88, 0.12);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.68);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
  }

  .testimonial-with-video {
    padding: 0.75rem 0.75rem 1rem;
  }

  .testimonial-with-video .testimonial-footer {
    margin-top: 0;
    padding: 0 0.5rem;
  }

  .testimonial-video {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #000;
  }

  .testimonial-video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .testimonial-quote {
    font-family: 'Fredoka', sans-serif;
    font-size: 1.02rem;
    line-height: 1.65;
    font-style: italic;
    font-weight: 500;
    margin: 0;
  }

  .testimonial-footer {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: auto;
  }

  .testimonial-attribution {
    font-family: 'Fredoka', sans-serif;
    font-weight: 600;
    margin: 0;
    text-align: left;
    color: var(--color-secondary);
  }

  .testimonial-context {
    margin: 0;
    font-family: 'Inter Variable', 'Inter', sans-serif;
    font-size: 0.92rem;
    color: rgba(45, 37, 73, 0.72);
  }
</style>
